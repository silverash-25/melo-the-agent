{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Plan",
  "type": "object",
  "properties": {
    "task_id": { "type": "string", "format": "uuid" },
    "objective": { "type": "string" },
    "steps": {
      "type": "array",
      "items": { "type": "string" }
    },
    "status": {
      "type": "string",
      "enum": ["pending", "in_progress", "completed", "failed"]
    }
  },
  "required": ["task_id", "objective", "steps", "status"]
}
